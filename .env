REACT_APP_CLOUD_NAME_CLOUDINARY = doz5sxyln
REACT_APP_BACKEND_URL = http://localhost:8080
# Production uses ".merasoftware.com" (set on the live host, not here). Locally this must stay
# "localhost" (or be left unset) so cookieManager.js's own check (src/utils/cookieManager.js:3-5)
# treats it as no domain restriction — otherwise the browser rejects the cookie on localhost and
# the portal session never verifies against the local backend.
REACT_APP_COOKIE_DOMAIN=localhost
PORT = 3001
